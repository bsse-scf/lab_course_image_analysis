#!/bin/bash

# `pixi run` looks for pixi.toml in the cwd, and jupyter-app-launcher reads
# jp_app_launcher*.yaml from the directory JupyterLab is started in, so run
# from the project. This does NOT make the project the server root: RRP passes
# /home/jovyan as root on the command line (students need `openbis`, `results`
# etc. in the file browser). The Course Tutor is found regardless, because
# .jupyter/jupyter_server_config.py points Jupyter AI at the project's
# `.jupyter/personas/` instead of walking up from the chat file.
cd /home/jovyan/project

# RRP-only resource limits. Both the Jupyter server and the XFCE desktop
# (started by jupyter-remote-desktop-proxy as a child of the server) inherit
# these, so they reach kernels, terminals and the Fiji/napari launchers alike.
export JAVA_TOOL_OPTIONS="-Xmx5g"
export OMP_NUM_THREADS=2
export MKL_NUM_THREADS=2
export OPENBLAS_NUM_THREADS=2

# postBuild installs the environment into ~/pixi-env (REPO_DIR is a different
# path at build time than at runtime, so it cannot live in the project). Pixi
# keys environments to the project directory, so without this link it would
# treat the project as uninstalled and rebuild the whole environment on every
# start. The manifest was copied verbatim, so the install marker still matches.
mkdir -p .pixi/envs
ln -sfn /home/jovyan/pixi-env/.pixi/envs/default .pixi/envs/default

# ---------------------------------------------------------------------------
# Jupyter App Launcher
#
# The launcher does NOT recursively search .jupyter/.
# Explicitly tell it where jp_app_launcher*.yml lives.
# ---------------------------------------------------------------------------

export JUPYTER_APP_LAUNCHER_PATH="/home/jovyan/project/.jupyter"

# Optional but useful diagnostics.
echo "RRP project: ${PWD}"
echo "Pixi root: ${PIXI_ROOT}"
echo "Launcher config: ${JUPYTER_APP_LAUNCHER_PATH}"

# Jupyternaut saves the secrets entered in "AI settings" (the OPENAI_API_KEY
# for the tutor) to `.env` at the server root, which on RRP is /home/jovyan.
# The home directory is part of the image and reset on every start, so the key
# would have to be re-entered each time. Keep it in the project instead, which
# is a persistent volume (and already gitignores `.env`). Jupyter resolves the
# link before writing, so the settings UI writes straight to project/.env. The
# target must exist: Jupyter answers 400 rather than 404 for a dangling link,
# which crashes Jupyternaut's `.env` watcher and fails the save.
(sleep 50 && cp /home/jovyan/openbis/data/20260918082954035-44/original/env /home/jovyan/project/.env && chmod 755 /home/jovyan/project/.env) &

touch .env
ln -sfn project/.env /home/jovyan/.env

exec pixi run "$@"
